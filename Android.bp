android_app {
    name: "FogosParts",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "SettingsLib",
        "androidx.core_core",
        "androidx.preference_preference",
    ],

    required: [
        "privapp_whitelist_org.lineageos.fogosparts.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.fogosparts.xml",
    src: "permissions/privapp_whitelist_org.lineageos.fogosparts.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
