<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/picture_control_title">

    <androidx.preference.SwitchPreferenceCompat
        android:key="kcal_enable"
        android:title="@string/kcal_enable_title"
        android:summary="@string/kcal_enable_summary"
        android:defaultValue="true" />

    <com.android.settingslib.widget.SliderPreference
        android:key="kcal_hue"
        android:title="@string/kcal_hue_title"
        android:defaultValue="0"
        app:showSeekBarValue="true"
        app:updatesContinuously="true"
        app:textStart="-180"
        app:textEnd="+180" />

    <com.android.settingslib.widget.SliderPreference
        android:key="kcal_sat"
        android:title="@string/kcal_sat_title"
        android:defaultValue="0"
        app:showSeekBarValue="true"
        app:updatesContinuously="true"
        app:textStart="-100"
        app:textEnd="+100" />

    <com.android.settingslib.widget.SliderPreference
        android:key="kcal_val"
        android:title="@string/kcal_val_title"
        android:defaultValue="0"
        app:showSeekBarValue="true"
        app:updatesContinuously="true"
        app:textStart="-100"
        app:textEnd="0" />

    <com.android.settingslib.widget.SliderPreference
        android:key="kcal_cont"
        android:title="@string/kcal_cont_title"
        android:defaultValue="0"
        app:showSeekBarValue="true"
        app:updatesContinuously="true"
        app:textStart="-100"
        app:textEnd="0" />

    <Preference
        android:key="kcal_reset"
        android:title="@string/kcal_reset_title"
        android:summary="@string/kcal_reset_summary" />

    <com.android.settingslib.widget.FooterPreference
        android:key="kcal_footer"
        android:title="@string/kcal_footer"
        android:selectable="false" />

</PreferenceScreen>
